<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.SemesterManagementView"
             Title="Semesters">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="Semester Dates"
                   FontSize="26" Style="{StaticResource Heading}"
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Semesters}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" Padding="12" Margin="0,4">
                            <VerticalStackLayout>
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10" RowSpacing="6">
                                    <Label Grid.Row="0" Grid.Column="0" Text="Start:" VerticalOptions="Center" />
                                    <DatePicker Grid.Row="0" Grid.Column="1" Date="{Binding StartDate}" />
                                    <Label Grid.Row="1" Grid.Column="0" Text="End:" VerticalOptions="Center" />
                                    <DatePicker Grid.Row="1" Grid.Column="1" Date="{Binding EndDate}" />
                                </Grid>
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Add a Semester" FontSize="18" FontAttributes="Bold" />
            <Entry x:Name="NewSemesterName" Placeholder="Semester name (e.g. Summer 2026)" />
            <Button Text="Add Semester" Clicked="OnAddSemester" />

            <Button Text="Back to Main Menu" Clicked="OnBackClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>