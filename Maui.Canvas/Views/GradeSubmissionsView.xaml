<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Maui.Canvas.Views.GradeSubmissionsView"
             Title="Grade Submissions">

    <ScrollView>
        <VerticalStackLayout Spacing="15" Padding="20">

            <Label Text="{Binding CourseTitle}" FontSize="26" Style="{StaticResource Heading}"
                   HorizontalOptions="Center" />

            <Label Text="No submissions to grade yet." IsVisible="{Binding HasNone}"
                   HorizontalOptions="Center" />

            <CollectionView ItemsSource="{Binding Rows}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Frame BorderColor="Gray" Padding="12" Margin="0,4">
                            <VerticalStackLayout>
                                <Label Text="{Binding Header}" FontSize="16" FontAttributes="Bold" />
                                <Label Text="{Binding Content}" FontSize="13" />
                                <Label Text="{Binding AvailablePoints, StringFormat='Out of {0} pts'}" FontSize="12" />
                                <Entry Text="{Binding GradeText}" Placeholder="Grade (points)" Keyboard="Numeric" />
                                <Entry Text="{Binding FeedbackText}" Placeholder="Feedback (optional)" />
                                <Button Text="Save Grade" Clicked="OnSaveGrade" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Button Text="Back" Clicked="OnBackClicked" />
            <Button Text="Main Menu" Clicked="OnMainMenuClicked" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>